---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';  
const { title = "デフォルトタイトル" } = Astro.props;
---

<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Kosugi+Maru&family=Zen+Maru+Gothic:wght@400;700;900&family=Galindo&display=swap" rel="stylesheet">
  <script is:inline>
    // FOUC防止: ページ描画前にテーマを適用
    (function() {
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body class="flex flex-col min-h-screen">
  <Header /> 

  <main class="container mx-auto p-4 flex-grow">
    <slot /> 
  </main>

  <Footer />
</body>
</html>