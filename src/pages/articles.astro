---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="Articles - mkz_uec25">
  <div class="max-w-6xl mx-auto px-4 pt-20 pb-24">

    <SectionHeading title="ARTICLES" />

    <!-- 2カラム: 左=記事一覧(2列)  右=サイドバー(スクロール付き) -->
    <div class="articles-layout section-fade-in">
      
      <!-- 左: 記事エリア (常に2列) -->
      <div class="articles-grid">
        <ArticleCard 
          title="激動の電通大1年を振り返ってみる"
          date="2026/03/02"
          imageUrl="https://placehold.jp/3d4070/ffffff/600x400.png?text=1"
          url="#"
          source="LOCAL"
        />
        <ArticleCard 
          title="【GitHub】GitHub Actionsで安定したプロフィールREADMEを錬成してみた"
          date="2026/02/26"
          imageUrl="https://placehold.jp/5d4070/ffffff/600x400.png?text=2"
          url="https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw"
          source="NOTE"
        />
      </div>

      <!-- 右: サイドバー (独立スクロール) -->
      <aside class="articles-sidebar">
        
        <!-- 検索ウィジェット -->
        <div class="sidebar-widget glass-card">
          <h3 class="sidebar-widget-title">SEARCH</h3>
          <div class="relative">
            <input 
              type="text" 
              placeholder="記事を検索..." 
              class="search-input"
              id="article-search"
            />
            <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        <!-- タグウィジェット -->
        <div class="sidebar-widget glass-card">
          <h3 class="sidebar-widget-title">TAGS</h3>
          <div class="flex flex-wrap gap-2">
            <a href="#" class="tag-link">Astro</a>
            <a href="#" class="tag-link">TailwindCSS</a>
            <a href="#" class="tag-link">Splatoon</a>
            <a href="#" class="tag-link">University</a>
            <a href="#" class="tag-link">GitHub</a>
            <a href="#" class="tag-link">Daily</a>
            <a href="#" class="tag-link">Tech</a>
          </div>
        </div>

      </aside>

    </div>

  </div>

  <style>
    /* メインの2カラムレイアウト */
    .articles-layout {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 2rem;
      align-items: start;
    }

    /* 記事カード 常に2列 */
    .articles-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      min-width: 0;
      text-align: left;
    }

    /* 右サイドバー: 固定高さ＋独立スクロール */
    .articles-sidebar {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding-right: 4px;
    }

    .sidebar-widget {
      padding: 1.5rem;
    }

    .sidebar-widget-title {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      margin-bottom: 1rem;
      font-family: 'Inter', monospace;
    }

    .search-input {
      width: 100%;
      padding: 0.75rem 0.75rem 0.75rem 2.5rem;
      background-color: var(--bg-card);
      border: 1px solid var(--glass-border);
      border-radius: 0.75rem;
      color: var(--text-primary);
      font-size: 0.875rem;
      outline: none;
      transition: all 0.3s ease;
    }

    .search-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--glow-color);
    }

    .search-icon {
      position: absolute;
      left: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      width: 1.125rem;
      height: 1.125rem;
      color: var(--text-muted);
    }

    .tag-link {
      display: inline-block;
      padding: 0.375rem 0.875rem;
      font-size: 0.8125rem;
      font-weight: 500;
      border-radius: 9999px;
      background: var(--bg-card);
      border: 1px solid var(--glass-border);
      color: var(--text-secondary);
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .tag-link:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: #ffffff;
      box-shadow: 0 0 12px var(--glow-color);
    }

    /* サイドバーのスクロールバーのスタイル */
    .articles-sidebar::-webkit-scrollbar {
      width: 4px;
    }
    .articles-sidebar::-webkit-scrollbar-track {
      background: transparent;
    }
    .articles-sidebar::-webkit-scrollbar-thumb {
      background: var(--glass-border);
      border-radius: 2px;
    }
    .articles-sidebar::-webkit-scrollbar-thumb:hover {
      background: var(--accent);
    }

    /* モバイルでは1カラム・縦積み */
    @media (max-width: 767px) {
      .articles-layout {
        grid-template-columns: 1fr;
      }
      .articles-grid {
        grid-template-columns: 1fr;
      }
      .articles-sidebar {
        position: static;
        max-height: none;
        overflow-y: visible;
      }
    }
  </style>
</BaseLayout>
