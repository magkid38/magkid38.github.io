---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
---

<BaseLayout title="Articles - mkz_uec25">
  <div class="max-w-6xl mx-auto px-4 mt-16 mb-24">

    <!-- ページ見出し -->
    <h2 class="text-3xl font-bold mb-10 tracking-wider text-left relative pl-2" style="font-family: 'Galindo', sans-serif;">
      <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-6 bg-[#ff1493]"></span>
      <span class="pl-4">ARTICLES</span>
    </h2>

    <!-- 2カラム: 左=記事一覧(2列)  右=サイドバー(スクロール付き) -->
    <div class="articles-layout">
      
      <!-- 左: 記事エリア (常に2列) -->
      <div class="articles-grid">
        <ArticleCard 
          title="激動の電通大1年を振り返ってみる"
          date="2026/03/02"
          imageUrl="https://placehold.jp/3d4070/ffffff/600x400.png?text=1"
          url="#"
          source="LOCAL"
        />
        <ArticleCard 
          title="【GitHub】GitHub Actionsで安定したプロフィールREADMEを錬成してみた"
          date="2026/02/26"
          imageUrl="https://placehold.jp/5d4070/ffffff/600x400.png?text=2"
          url="https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw"
          source="NOTE"
        />
      </div>

      <!-- 右: サイドバー (独立スクロール) -->
      <aside class="articles-sidebar">
        
        <!-- 検索ウィジェット -->
        <div class="sidebar-widget">
          <h3 class="text-xl font-bold mb-4 font-mono">SEARCH</h3>
          <div class="relative">
            <input 
              type="text" 
              placeholder="記事を検索..." 
              class="search-input w-full rounded-lg pl-10 pr-4 py-3 focus:outline-none transition-colors"
            />
            <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2" style="color: var(--text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        <!-- タグウィジェット -->
        <div class="sidebar-widget">
          <h3 class="text-xl font-bold mb-4 font-mono">TAGS</h3>
          <div class="flex flex-wrap gap-2">
            <a href="#" class="tag-link px-3 py-1.5 text-sm rounded-lg transition-colors font-medium">Astro</a>
            <a href="#" class="tag-link px-3 py-1.5 text-sm rounded-lg transition-colors font-medium">TailwindCSS</a>
            <a href="#" class="tag-link px-3 py-1.5 text-sm rounded-lg transition-colors font-medium">Splatoon</a>
            <a href="#" class="tag-link px-3 py-1.5 text-sm rounded-lg transition-colors font-medium">University</a>
            <a href="#" class="tag-link px-3 py-1.5 text-sm rounded-lg transition-colors font-medium">GitHub</a>
            <a href="#" class="tag-link px-3 py-1.5 text-sm rounded-lg transition-colors font-medium">Daily</a>
            <a href="#" class="tag-link px-3 py-1.5 text-sm rounded-lg transition-colors font-medium">Tech</a>
          </div>
        </div>

      </aside>

    </div>

  </div>

  <style>
    /* メインの2カラムレイアウト */
    .articles-layout {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 2rem;
      align-items: start;
    }

    /* 記事カード 常に2列 */
    .articles-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      min-width: 0;
      text-align: left;
    }

    /* 右サイドバー: 固定高さ＋独立スクロール */
    .articles-sidebar {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-right: 4px;
    }

    .sidebar-widget {
      background-color: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 0.75rem;
      padding: 1.5rem;
      box-shadow: var(--shadow-card);
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .search-input {
      background-color: var(--input-bg);
      border: 1px solid var(--input-border);
      color: var(--text-primary);
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }
    .search-input:focus {
      border-color: #ff1493;
    }

    .tag-link {
      background-color: var(--bg-card);
      color: var(--text-primary);
    }
    .tag-link:hover {
      background-color: rgba(255, 20, 147, 0.8);
      color: #ffffff;
    }

    /* サイドバーのスクロールバーのスタイル */
    .articles-sidebar::-webkit-scrollbar {
      width: 6px;
    }
    .articles-sidebar::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.05);
      border-radius: 3px;
    }
    .articles-sidebar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 3px;
    }
    .articles-sidebar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 20, 147, 0.5);
    }

    /* モバイルでは1カラム・縦積み */
    @media (max-width: 767px) {
      .articles-layout {
        grid-template-columns: 1fr;
      }
      .articles-grid {
        grid-template-columns: 1fr;
      }
      .articles-sidebar {
        position: static;
        max-height: none;
        overflow-y: visible;
      }
    }
  </style>
</BaseLayout>
