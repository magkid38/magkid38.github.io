---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="Status - mkz_uec25">
  <div class="max-w-4xl mx-auto px-4 pt-20 pb-24">

    <!-- STATS INTRO -->
    <SectionHeading 
      title="MY STATUS" 
      subtitle="これまでのGPA推移とTOEICスコアの軌跡です。"
    />
    <p class="status-note section-fade-in">
      ※プロット（点）をクリックすると当時の記事へ、カーソルを合わせると詳細が表示されます。
    </p>

    <!-- GPA CHART -->
    <section class="chart-section section-fade-in">
      <h3 class="chart-title">GPA 推移</h3>
      <div class="chart-container glass-card">
        <canvas id="gpaChart"></canvas>
      </div>
    </section>

    <!-- TOEIC CHART -->
    <section class="chart-section section-fade-in delay-1">
      <h3 class="chart-title">TOEIC スコア推移</h3>
      <div class="chart-container glass-card">
        <canvas id="toeicChart"></canvas>
      </div>
    </section>

  </div>

  <!-- Chart.js CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script is:inline>
    // GPAデータ
    const gpaData = [
      { date: '1年 前期', gpa: 2.125, url: 'https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw', info: '最初の学期' },
      { date: '1年 後期', gpa: 2.6118, url: 'https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw', info: '' },
      { date: '2年 前期', gpa: null, url: '', info: '' },
      { date: '2年 後期', gpa: null, url: '', info: '' },
      { date: '3年 前期', gpa: null, url: '', info: '' },
      { date: '3年 後期', gpa: null, url: '', info: '' },
      { date: '4年 前期', gpa: null, url: '', info: '' },
      { date: '4年 後期', gpa: null, url: '', info: '' }
    ];

    // TOEICダミーデータ
    const toeicData = [
      { date: '2024/05/20', score: 450, url: 'https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw', info: '初めてのTOEIC受験、時間配分に苦労' },
      { date: '2024/10/12', score: 620, url: 'https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw', info: '単語帳を一周してベースアップ' },
      { date: '2025/03/05', score: 710, url: 'https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw', info: 'リスニング強化合宿の成果が出た' },
      { date: '2025/08/21', score: 850, url: 'https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw', info: '目標の800点突破！大歓喜' }
    ];

    // 共通のフォント色(ダークモード対応)
    Chart.defaults.color = '#94a3b8'; 
    Chart.defaults.font.family = "'Inter', 'Kosugi Maru', 'Zen Maru Gothic', sans-serif";

    // --- GPA Chart ---
    const ctxGpa = document.getElementById('gpaChart').getContext('2d');
    new Chart(ctxGpa, {
      type: 'line',
      data: {
        labels: gpaData.map(d => d.date),
        datasets: [{
          label: 'GPA',
          data: gpaData.map(d => d.gpa),
          borderColor: '#ff1493',
          backgroundColor: 'rgba(255, 20, 147, 0.1)',
          fill: true,
          tension: 0.4,
          pointRadius: 6,
          pointHoverRadius: 10,
          pointBackgroundColor: '#ffffff',
          pointBorderColor: '#ff1493',
          pointBorderWidth: 2,
          pointHoverBorderWidth: 3,
          borderWidth: 2,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        onClick: (e, activeEls) => {
          if (activeEls.length > 0) {
            const index = activeEls[0].index;
            if (gpaData[index].url) window.open(gpaData[index].url, '_blank');
          }
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(15, 23, 42, 0.95)',
            titleFont: { size: 13, weight: 'bold' },
            bodyFont: { size: 12 },
            padding: 12,
            cornerRadius: 8,
            borderColor: 'rgba(255, 20, 147, 0.3)',
            borderWidth: 1,
            callbacks: {
              title: (ctx) => `${gpaData[ctx[0].dataIndex].date}のGPA: ${gpaData[ctx[0].dataIndex].gpa}`,
              label: (ctx) => `${gpaData[ctx.dataIndex].info}`
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            max: 4.0,
            grid: { color: 'rgba(148, 163, 184, 0.08)' },
            border: { color: 'transparent' }
          },
          x: {
            grid: { display: false },
            border: { color: 'transparent' }
          }
        }
      }
    });

    // --- TOEIC Chart ---
    const ctxToeic = document.getElementById('toeicChart').getContext('2d');
    new Chart(ctxToeic, {
      type: 'line',
      data: {
        labels: toeicData.map(d => d.date),
        datasets: [{
          label: 'TOEIC Score',
          data: toeicData.map(d => d.score),
          borderColor: '#6366f1',
          backgroundColor: 'rgba(99, 102, 241, 0.1)',
          fill: true,
          tension: 0.4,
          pointRadius: 6,
          pointHoverRadius: 10,
          pointBackgroundColor: '#ffffff',
          pointBorderColor: '#6366f1',
          pointBorderWidth: 2,
          pointHoverBorderWidth: 3,
          borderWidth: 2,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        onClick: (e, activeEls) => {
          if (activeEls.length > 0) {
            const index = activeEls[0].index;
            if (toeicData[index].url) window.open(toeicData[index].url, '_blank');
          }
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: 'rgba(15, 23, 42, 0.95)',
            titleFont: { size: 13, weight: 'bold' },
            bodyFont: { size: 12 },
            padding: 12,
            cornerRadius: 8,
            borderColor: 'rgba(99, 102, 241, 0.3)',
            borderWidth: 1,
            callbacks: {
              title: (ctx) => `${toeicData[ctx[0].dataIndex].date}受験 スコア: ${toeicData[ctx[0].dataIndex].score}`,
              label: (ctx) => `${toeicData[ctx.dataIndex].info}`
            }
          }
        },
        scales: {
          y: {
            min: 0,
            max: 990,
            grid: { color: 'rgba(148, 163, 184, 0.08)' },
            border: { color: 'transparent' }
          },
          x: {
            grid: { display: false },
            border: { color: 'transparent' }
          }
        }
      }
    });

    // ホバー時にカーソルを指マークに変える処理（UX向上用）
    const handleCursor = (e, ctx) => {
      e.native.target.style.cursor = ctx[0] ? 'pointer' : 'default';
    };
    
    // オプションにホバー処理を追加
    Chart.instances[0].options.onHover = handleCursor;
    Chart.instances[1].options.onHover = handleCursor;
  </script>

  <style>
    .status-note {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--accent);
      margin-top: -0.5rem;
      margin-bottom: 3rem;
      padding-left: 1.25rem;
    }

    .chart-section {
      margin-bottom: 3rem;
    }

    .chart-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--glass-border);
      color: var(--text-primary);
    }

    .chart-container {
      padding: 1.5rem;
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
    }

    @media (min-width: 768px) {
      .chart-container {
        aspect-ratio: 21 / 9;
      }
    }
  </style>
</BaseLayout>
