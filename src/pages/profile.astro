---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="Profile - mkz_uec25">
  <div class="max-w-3xl mx-auto px-4 pt-20 pb-24">

    <SectionHeading title="PROFILE" />

    <!-- About Me -->
    <section class="profile-section glass-card section-fade-in">
      <h3 class="profile-section-title">About Me</h3>
      <p class="profile-text text-lg">ご飯を食べるのと寝るのが好きです。</p>
    </section>

    <!-- 関心 -->
    <section class="profile-section glass-card section-fade-in delay-1">
      <h3 class="profile-section-title">関心</h3>
      <ul class="interest-list">
        <li class="interest-item">
          <span class="interest-dot"></span>
          おいしいごはんを食べる
        </li>
        <li class="interest-item">
          <span class="interest-dot"></span>
          写真を撮る
        </li>
        <li class="interest-item">
          <span class="interest-dot"></span>
          情報検索・推薦
        </li>
        <li class="interest-item">
          <span class="interest-dot"></span>
          旅をする
        </li>
        <li class="interest-item">
          <span class="interest-dot"></span>
          音楽を聴く 🎵
        </li>
      </ul>
    </section>

    <!-- 経歴 -->
    <section class="profile-section glass-card section-fade-in delay-2">
      <h3 class="profile-section-title">経歴</h3>
      <p class="profile-text" style="color: var(--text-muted);">Coming soon...</p>
    </section>

  </div>

  <style>
    .profile-section {
      padding: 2rem;
      margin-bottom: 1.5rem;
    }

    .profile-section-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--glass-border);
      color: var(--text-primary);
    }

    .profile-text {
      color: var(--text-secondary);
      line-height: 1.8;
    }

    .interest-list {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
    }

    .interest-item {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      font-size: 1.0625rem;
      color: var(--text-secondary);
      transition: color 0.2s ease;
    }

    .interest-item:hover {
      color: var(--text-primary);
    }

    .interest-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent-gradient);
      flex-shrink: 0;
    }
  </style>
</BaseLayout>