---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="mkz_uec25">
  <div class="flex flex-col items-center justify-center min-h-screen text-center bg-gray-800 -m-4 p-4">
    <div class="max-w-3xl mx-auto text-left">
      
      <section class="mb-12">
        <h2 class="text-3xl font-bold mb-4 border-b border-white/30 pb-2">About Me</h2>
        <p class="text-xl">ご飯を食べるのと寝るのが好きです。</p>
      </section>

      <section class="mb-12">
        <h2 class="text-3xl font-bold mb-4 border-b border-white/30 pb-2">関心</h2>
        <ul class="space-y-3 text-lg">
          <li class="flex items-center gap-3">
            <span class="text-xs">●</span> おいしいごはんを食べる
          </li>
          <li class="flex items-center gap-3">
            <span class="text-xs">●</span> 写真を撮る
          </li>
          <li class="flex items-center gap-3">
            <span class="text-xs">●</span> 情報検索・推薦
          </li>
          <li class="flex items-center gap-3">
            <span class="text-xs">●</span> 旅をする
          </li>
          <li class="flex items-center gap-3">
            <span class="text-xs">●</span> 音楽を聴く 🎵
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-3xl font-bold mb-4 border-b border-white/30 pb-2">経歴</h2>
        </section>

    </div>
  </div>
</Baselayout>