---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="mkz_uec25">

  <!-- ========================================
       Hero Section
       ======================================== -->
  <section class="hero-section">
    <!-- Background Orbs -->
    <div class="hero-orbs" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>

    <div class="hero-content">
      <p class="hero-tagline section-fade-in">Splatoon Otaku</p>
      
      <h1 class="hero-title section-fade-in delay-1">
        MKZ'S<br />WEBSITE
      </h1>
      
      <!-- Social Icons -->
      <div class="hero-socials section-fade-in delay-2">
        <!-- 1. X (Twitter) -->
        <a href="https://x.com/mkz_uec25" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="X (Twitter)">
          <svg class="w-[18px] h-[18px] fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <!-- 2. GitHub -->
        <a href="https://github.com/magkid38" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <!-- 3. Zenn -->
        <a href="https://zenn.dev/magkid" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Zenn">
          <svg class="w-[18px] h-[18px] fill-current" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.176-.293-.029-.645-.381-.645h-4.72c-.235 0-.44.117-.557.323L.03 23.361c-.088.176.029.41.234.41zM17.445 23.419l6.479-10.408c.205-.323-.029-.733-.41-.733h-4.691c-.176 0-.352.088-.44.235l-6.655 10.643c-.176.264.029.616.352.616h4.779c.234-.001.468-.118.586-.353z"/></svg>
        </a>
        <!-- 4. Note -->
        <a href="https://note.com/mkz_uec25" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Note">
          <svg class="w-4 h-4 fill-current" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M0 .279c4.623 0 10.953-.235 15.498-.117 6.099.156 8.39 2.813 8.468 9.374.077 3.71 0 14.335 0 14.335h-6.598c0-9.296.04-10.83 0-13.759-.078-2.578-.814-3.807-2.795-4.041-2.097-.235-7.975-.04-7.975-.04v17.84H0Z"/></svg>
        </a>
        <!-- 5. Lock (Private) -->
        <a href="https://x.com/_mkzcore" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="鍵アカウント">
          <svg class="w-[18px] h-[18px] fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M256 160L256 224L384 224L384 160C384 124.7 355.3 96 320 96C284.7 96 256 124.7 256 160zM192 224L192 160C192 89.3 249.3 32 320 32C390.7 32 448 89.3 448 160L448 224C483.3 224 512 252.7 512 288L512 512C512 547.3 483.3 576 448 576L192 576C156.7 576 128 547.3 128 512L128 288C128 252.7 156.7 224 192 224z"/></svg>
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="scroll-indicator section-fade-in delay-3">
        <svg class="scroll-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </div>
    </div>
  </section>

  <!-- ========================================
       Latest Articles Section
       ======================================== -->
  <section class="content-section">
    <div class="content-wrapper">
      <SectionHeading 
        title="LATEST" 
        linkText="すべての記事を見る" 
        linkHref="/articles" 
      />
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 section-fade-in">
        <!-- Card 1 -->
        <ArticleCard 
          title="数弱の転類体験記2026"
          date="2026/03/02"
          imageUrl="https://placehold.jp/3d4070/ffffff/600x400.png?text=1"
          url="https://note.com/mkz_uec25/n/nd386b79bed6e?sub_rt=share_sb"
          source="NOTE"
        />
        <!-- Card 2 -->
        <ArticleCard 
          title="【#uec_review】2年 Bクラス 前期"
          date="2026/02/26"
          imageUrl="https://placehold.jp/5d4070/ffffff/600x400.png?text=2"
          url="https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw"
          source="LOCAL"
        />
      </div>
    </div>
  </section>

  <!-- ========================================
       About Me Section
       ======================================== -->
  <section class="content-section">
    <div class="content-wrapper">
      <SectionHeading 
        title="ABOUT ME" 
        linkText="詳しくはこちら" 
        linkHref="/profile" 
      />
      
      <div class="about-card glass-card section-fade-in">
        <div class="about-card-inner">
          <p>いろんな技術を気ままに勉強中。</p>
          <p>現在 UEC25 Ⅱ類 所属。</p>
          <p class="about-highlight">楽しく生きる！</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ========================================
       Hero Section
       ======================================== */
    .hero-section {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero-orbs {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      animation: float 12s ease-in-out infinite;
    }

    .orb-1 {
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(255, 20, 147, 0.15), transparent 70%);
      top: -10%;
      right: -5%;
      animation-delay: 0s;
    }

    .orb-2 {
      width: 350px;
      height: 350px;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.12), transparent 70%);
      bottom: -5%;
      left: -10%;
      animation-delay: -4s;
    }

    .orb-3 {
      width: 250px;
      height: 250px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.1), transparent 70%);
      top: 40%;
      left: 50%;
      animation-delay: -8s;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 2rem 1rem;
    }

    .hero-tagline {
      font-size: 0.75rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      font-weight: 500;
    }

    .hero-title {
      font-family: 'Galindo', sans-serif;
      font-size: clamp(3rem, 10vw, 5.5rem);
      line-height: 1.1;
      letter-spacing: 0.05em;
      margin-bottom: 3rem;
      background: var(--accent-gradient-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Social Icons */
    .hero-socials {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 4rem;
    }

    .social-icon {
      width: 2.75rem;
      height: 2.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 0.75rem;
      background: var(--glass-bg);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--glass-border);
      color: var(--text-muted);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .social-icon:hover {
      color: var(--text-primary);
      border-color: var(--accent);
      box-shadow: 0 0 20px var(--glow-color), 0 0 40px var(--glow-color);
      transform: translateY(-2px);
    }

    /* Scroll Indicator */
    .scroll-indicator {
      display: flex;
      justify-content: center;
    }

    .scroll-chevron {
      color: var(--text-muted);
      opacity: 0.5;
      animation: bounce-soft 2s ease-in-out infinite;
    }

    /* ========================================
       Content Sections
       ======================================== */
    .content-section {
      padding: 4rem 1rem;
    }

    .content-wrapper {
      max-width: 72rem;
      margin: 0 auto;
    }

    /* About Card */
    .about-card {
      padding: 2rem 2.5rem;
    }

    .about-card-inner {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      font-size: 0.9375rem;
      color: var(--text-secondary);
      line-height: 1.8;
    }

    .about-highlight {
      font-weight: 700;
      background: var(--accent-gradient-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-size: 1.125rem;
      margin-top: 0.5rem;
    }

    /* ========================================
       Responsive
       ======================================== */
    @media (max-width: 640px) {
      .orb-1 { width: 250px; height: 250px; }
      .orb-2 { width: 200px; height: 200px; }
      .orb-3 { width: 150px; height: 150px; }
      .content-section { padding: 3rem 1rem; }
      .about-card { padding: 1.5rem; }
    }
  </style>
</BaseLayout>