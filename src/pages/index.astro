---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
---

<BaseLayout title="mkz_uec25">
  <div class="flex flex-col items-center justify-center min-h-screen text-center px-4 relative">
    

    <!-- Hero Section -->
    <div class="mt-16 flex flex-col items-center">
      <p class="text-sm tracking-widest uppercase mb-4 opacity-80" style="color: var(--text-secondary);">Splatoon Otaku</p>
      
      <h1 class="text-5xl sm:text-7xl mb-10 tracking-widest leading-tight" style="font-family: 'Galindo', sans-serif; color: var(--text-primary);">
        MKZ'S<br />WEBSITE
      </h1>
      
      <!-- Social Icons -->
      <div class="flex justify-center items-center space-x-4 sm:space-x-6 mb-24">
        <!-- 1. X (Twitter) -->
        <a href="https://x.com/mkz_uec25" target="_blank" rel="noopener noreferrer" class="social-icon">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <!-- 2. GitHub -->
        <a href="https://github.com/magkid38" target="_blank" rel="noopener noreferrer" class="social-icon">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <!-- 3. Zenn -->
        <a href="https://zenn.dev/magkid" target="_blank" rel="noopener noreferrer" class="social-icon">
          <svg class="w-5 h-5 fill-current" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.176-.293-.029-.645-.381-.645h-4.72c-.235 0-.44.117-.557.323L.03 23.361c-.088.176.029.41.234.41zM17.445 23.419l6.479-10.408c.205-.323-.029-.733-.41-.733h-4.691c-.176 0-.352.088-.44.235l-6.655 10.643c-.176.264.029.616.352.616h4.779c.234-.001.468-.118.586-.353z"/></svg>
        </a>
        <!-- 4. Note -->
        <a href="https://note.com/mkz_uec25" target="_blank" rel="noopener noreferrer" class="social-icon">
          <svg class="w-4 h-4 fill-current" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M0 .279c4.623 0 10.953-.235 15.498-.117 6.099.156 8.39 2.813 8.468 9.374.077 3.71 0 14.335 0 14.335h-6.598c0-9.296.04-10.83 0-13.759-.078-2.578-.814-3.807-2.795-4.041-2.097-.235-7.975-.04-7.975-.04v17.84H0Z"/></svg>
        </a>
        <!-- 5. Lock (Private) -->
        <a href="https://x.com/_mkzcore" target="_blank" rel="noopener noreferrer" class="social-icon">
          <svg class="w-5 h-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M256 160L256 224L384 224L384 160C384 124.7 355.3 96 320 96C284.7 96 256 124.7 256 160zM192 224L192 160C192 89.3 249.3 32 320 32C390.7 32 448 89.3 448 160L448 224C483.3 224 512 252.7 512 288L512 512C512 547.3 483.3 576 448 576L192 576C156.7 576 128 547.3 128 512L128 288C128 252.7 156.7 224 192 224z"/></svg>
        </a>
      </div>
    </div>

    <!-- Latest Articles Section -->
    <div class="w-full max-w-5xl mb-32">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-8 pl-2 pr-2 gap-4">
        <h2 class="text-3xl font-bold tracking-wider text-left relative" style="font-family: 'Galindo', sans-serif;">
          <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-6 bg-[#ff1493]"></span>
          <span class="pl-4">LATEST</span>
        </h2>
        <a href="/articles" class="view-all-btn text-sm font-bold py-2 px-4 rounded-full transition-colors flex items-center justify-center">
          すべての記事を見る <span class="ml-1">&rarr;</span>
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
        <!-- Card 1 -->
        <ArticleCard 
          title="激動の電通大1年を振り返ってみる"
          date="2026/03/02"
          imageUrl="https://placehold.jp/3d4070/ffffff/600x400.png?text=1"
          url="#"
          source="LOCAL"
        />
        <!-- Card 2 -->
        <ArticleCard 
          title="【GitHub】GitHub Actionsで安定したプロフィールREADMEを錬成してみた"
          date="2026/02/26"
          imageUrl="https://placehold.jp/5d4070/ffffff/600x400.png?text=2"
          url="https://note.com/mkz_uec25/n/ne7445231c55c?sub_rt=share_pw"
          source="NOTE"
        />
        <!-- Card 3 -->
        <ArticleCard 
          title="トラマトのホームページ、爆誕"
          date="2026/01/02"
          imageUrl="https://placehold.jp/405d70/ffffff/600x400.png?text=3"
          url="#"
          source="LOCAL"
        />
      </div>
    </div>

    <!-- About Me Section -->
    <div class="w-full max-w-sm">
      <h2 class="text-xl font-bold mb-6 tracking-wider text-left pl-2 relative">
        <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-5" style="background-color: var(--text-primary);"></span>
        ABOUT ME
      </h2>
      <div class="space-y-3 text-sm text-left pl-2" style="color: var(--text-secondary);">
        <p>いろんな技術を気ままに勉強中。</p>
        <p>現在 UEC25 Ⅱ類 所属。</p>
        <p>楽しく生きる！</p>
      </div>
    </div>

  </div>

  <style>
    .social-icon {
      width: 3rem;
      height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background-color: var(--bg-card);
      color: var(--text-primary);
      transition: background-color 0.2s;
    }
    .social-icon:hover {
      background-color: var(--bg-card-hover);
    }

    .view-all-btn {
      background-color: var(--bg-card);
      color: var(--text-primary);
    }
    .view-all-btn:hover {
      background-color: var(--bg-card-hover);
    }
  </style>
</BaseLayout>