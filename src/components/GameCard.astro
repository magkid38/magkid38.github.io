---
interface Props {
  title: string;
  playtime?: string;
  description: string;
  screenshots: { src: ImageMetadata | string; alt: string; caption?: string }[];
  accent?: string;
}

const { title, playtime, description, screenshots, accent = '#ff1493' } = Astro.props;
---

<div class="game-card bg-white/5 border border-white/10 rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300">
  
  <!-- Header -->
  <div class="p-6 pb-4">
    <div class="flex items-start justify-between gap-4 mb-3">
      <h3 class="text-2xl font-bold" style={`color: ${accent};`}>{title}</h3>
      {playtime && (
        <span class="shrink-0 text-xs font-mono bg-white/10 text-gray-300 px-3 py-1.5 rounded-full whitespace-nowrap">
          {playtime}
        </span>
      )}
    </div>
    <p class="text-gray-300 leading-relaxed text-sm">{description}</p>
  </div>

  <!-- Screenshot Gallery -->
  {screenshots.length > 0 && (
    <div class="px-6 pb-6">
      <div class={`screenshot-grid screenshot-grid-${Math.min(screenshots.length, 4)}`}>
        {screenshots.map((shot, i) => (
          <button
            class="screenshot-thumb group relative overflow-hidden rounded-lg border border-white/10 hover:border-white/30 transition-all duration-300 cursor-pointer bg-transparent p-0"
            data-index={i}
            data-game={title}
          >
            {typeof shot.src === 'string' ? (
              <img
                src={shot.src}
                alt={shot.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
              />
            ) : (
              <img
                src={shot.src.src}
                alt={shot.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
              />
            )}
            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 flex items-center justify-center">
              <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </div>
            {shot.caption && (
              <span class="absolute bottom-0 left-0 right-0 bg-black/60 text-white text-xs px-2 py-1 truncate">
                {shot.caption}
              </span>
            )}
          </button>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .screenshot-grid {
    display: grid;
    gap: 0.5rem;
  }

  .screenshot-grid-1 {
    grid-template-columns: 1fr;
  }

  .screenshot-grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .screenshot-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .screenshot-grid-4 {
    grid-template-columns: repeat(2, 1fr);
  }

  .screenshot-thumb {
    aspect-ratio: 16 / 9;
    width: 100%;
  }

  @media (max-width: 640px) {
    .screenshot-grid-3,
    .screenshot-grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
