---
// 現在のURLパスを取得して、どのメニューが「アクティブ」か判定する
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // 先頭の / を除去

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/articles' },
  { name: 'Games', href: '/games' },
  { name: 'Profile', href: '/profile' },
  { name: 'Status', href: '/status' },
];
---

<header class="header-bar py-4 px-6 shadow-md relative z-50">
  <div class="container mx-auto flex items-center justify-between">
    <!-- 左側 (バランス確保のための空要素) -->
    <div class="flex-1 hidden md:block"></div>

    <!-- 中央ナビゲーション (モバイルでは非表示) -->
    <nav class="hidden md:flex justify-center space-x-8 flex-1">
      {navItems.map((item) => {
        const isActive = item.href === '/' 
          ? pathname === '/' 
          : pathname.startsWith(item.href);

        return (
          <a 
            href={item.href} 
            class={`relative pb-2 text-lg font-bold transition-colors duration-200 ${
              isActive ? 'text-[#ff1493]' : 'nav-link'
            }`}
          >
            {item.name}
            {isActive && (
              <div class="absolute bottom-0 left-0 w-full h-1 bg-[#ff1493] rounded-full" />
            )}
          </a>
        );
      })}
    </nav>
    
    <!-- 右側ボタン群 (Theme / Menu) -->
    <div class="flex items-center space-x-2 md:space-x-4 flex-1 justify-end">
      <!-- テーマ切替ボタン -->
      <button id="theme-toggle" class="p-2 hover:bg-white/10 rounded-full transition" aria-label="テーマ切替">
        <!-- 太陽アイコン (ダーク時に表示 → ライトに切替) -->
        <svg id="icon-sun" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <!-- 月アイコン (ライト時に表示 → ダークに切替) -->
        <svg id="icon-moon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>
      <!-- ハンバーガーメニュー (モバイルのみ表示) -->
      <button id="mobile-menu-btn" class="p-2 hover:bg-white/10 rounded-full transition md:hidden">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>

  <!-- モバイルメニュー (デフォルトは非表示) -->
  <nav id="mobile-menu" class="hidden md:hidden mt-4 pb-2 border-t pt-4" style="border-color: var(--border-card);">
    <div class="flex flex-col space-y-3">
      {navItems.map((item) => {
        const isActive = item.href === '/' 
          ? pathname === '/' 
          : pathname.startsWith(item.href);

        return (
          <a 
            href={item.href} 
            class={`px-4 py-2 rounded-lg text-base font-bold transition-colors duration-200 ${
              isActive ? 'text-[#ff1493] mobile-nav-active' : 'nav-link mobile-nav-link'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<style>
  .header-bar {
    background-color: var(--bg-header);
    color: var(--text-primary);
    transition: background-color 0.3s ease, color 0.3s ease;
    border-bottom: 1px solid var(--border-card);
  }

  .nav-link {
    color: var(--text-muted);
  }
  .nav-link:hover {
    color: var(--text-primary);
  }

  .mobile-nav-link:hover {
    background-color: var(--bg-card);
  }
  .mobile-nav-active {
    background-color: var(--bg-card);
  }

  #theme-toggle {
    color: var(--text-primary);
  }
  #theme-toggle:hover {
    background-color: var(--bg-card);
  }

  #mobile-menu-btn {
    color: var(--text-primary);
  }
  #mobile-menu-btn:hover {
    background-color: var(--bg-card);
  }
</style>

<script is:inline>
  // モバイルメニュー
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    const menu = document.getElementById('mobile-menu');
    if (menu) {
      menu.classList.toggle('hidden');
    }
  });

  // テーマ切替
  (function() {
    const toggle = document.getElementById('theme-toggle');
    const iconSun = document.getElementById('icon-sun');
    const iconMoon = document.getElementById('icon-moon');

    function updateIcons() {
      const theme = document.documentElement.getAttribute('data-theme') || 'dark';
      if (theme === 'dark') {
        iconSun.classList.remove('hidden');
        iconMoon.classList.add('hidden');
      } else {
        iconSun.classList.add('hidden');
        iconMoon.classList.remove('hidden');
      }
    }

    // initial
    updateIcons();

    toggle?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateIcons();
    });
  })();
</script>