---
interface Props {
  title: string;
  date: string;
  imageUrl: string;
  url: string;
  source: 'LOCAL' | 'ZENN' | 'NOTE';
}

const { title, date, imageUrl, url, source } = Astro.props;

// Determine badge color based on source
const badgeColors = {
  LOCAL: 'bg-blue-500 text-white',
  ZENN: 'bg-blue-400 text-white',
  NOTE: 'bg-emerald-500 text-white',
};
---

<a href={url} target="_blank" rel="noopener noreferrer" class="block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 border border-gray-100 flex flex-col h-full group">
  <!-- Image Container -->
  <div class="relative w-full aspect-[16/9] overflow-hidden bg-gray-100">
    <img 
      src={imageUrl} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <!-- Source Badge -->
    <div class={`absolute top-0 right-0 px-3 py-1 text-xs font-bold font-mono tracking-wider ${badgeColors[source]} rounded-bl-lg`}>
      {source}
    </div>
  </div>
  
  <!-- Content Container -->
  <div class="p-5 flex flex-col flex-grow">
    <time class="text-sm text-gray-400 mb-2 font-medium">{date}</time>
    <h3 class="text-gray-800 font-bold text-base md:text-lg leading-snug line-clamp-3">
      {title}
    </h3>
  </div>
</a>
